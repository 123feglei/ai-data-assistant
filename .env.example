# ===== DeepSeek API 配置模板 =====
# 使用方法：
#   1. 复制本文件为 .env（cp .env.example .env）
#   2. 到 https://platform.deepseek.com 注册并充值（10 元足够开发期使用）
#   3. 在「API Keys」页面创建 Key，填入下方 DEEPSEEK_API_KEY
#   4. 运行测试：python scripts/test_llm.py

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 数据库路径（默认 data/ecommerce.db，一般无需修改）
DB_PATH=data/ecommerce.db

# LLM 请求超时（秒）
LLM_TIMEOUT=60
